generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// The connection URL lives in prisma.config.ts; Prisma 7 no longer accepts it here.
datasource db {
  provider = "postgresql"
}

model Admin {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String         @map("password_hash")
  role         String         @default("admin")
  isActive     Boolean        @default(true) @map("is_active")
  lastLogin    DateTime?      @map("last_login")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admins")
}

/// A logged-in administrator.
///
/// The id is the SHA-256 of the token in the cookie, never the token itself:
/// the token carries 256 bits of entropy, so hashing it costs nothing, and it
/// means a leaked dump of this table cannot be replayed as a live session.
model AdminSession {
  id        String   @id
  adminId   String   @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Application feature settings, as one row holding the whole config document.
///
/// A row per key would make a partial save look like a valid config with some
/// keys missing; one document means a save is all-or-nothing, which is the same
/// guarantee the previous atomic file write gave.
model AppSetting {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
